# ==============================================================================
# MK DATA — Environment Variables Specification & Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development or populate in Vercel Settings.
# Never commit actual production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & BRANDING CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL of the application (Used for SEO, OpenGraph metadata, and webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment: "development" | "production" | "test"
NODE_ENV="development"

# Server Port (Defaults to 3000)
PORT="3000"


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Neon Serverless PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# Primary pooled database connection string
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection string for Prisma migrations and schema push (Optional)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-1.aws.neon.tech/neondb?sslmode=require"


# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# High-entropy secret key for signing user session JWT tokens
JWT_SECRET="your-super-secret-jwt-signing-key-min-32-characters"

# Master administrator fallback authentication password
ADMIN_PASSWORD="your-secure-admin-password"

# Initial seed administrator credentials (Used during npm run seed)
MK_ADMIN_PHONE="09066120642"
MK_ADMIN_NAME="MK Data Admin"
MK_ADMIN_PIN="000000"


# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAYS & WEBHOOK INTEGRATIONS (BillStack)
# ------------------------------------------------------------------------------
# BillStack API Secret Key (Used for generating virtual accounts & verifying webhooks)
BILLSTACK_SECRET_KEY="sk_live_sample_billstack_secret_key"

# BillStack Base API URL
BILLSTACK_BASE_URL="https://api.billstack.co/v1"


# ------------------------------------------------------------------------------
# 5. THIRD-PARTY VTU & TELECOM VENDOR APIS
# ------------------------------------------------------------------------------
# --- Alrahuz Data Integration ---
ALRAHUZ_API_TOKEN="your_alrahuz_api_token"
ALRAHUZ_EPIN_API_TOKEN="your_alrahuz_epin_token_if_separate"
ALRAHUZ_BASE_URL="https://alrahuzdata.com.ng"

# --- AmySub Integration ---
AMYSUB_API_KEY="your_amysub_api_key"
AMYSUB_API_URL="https://app.amysub.ng/api"

# --- Saiful Legend Connect Integration ---
SAIFUL_API_KEY="your_saiful_api_key"
SAIFUL_API_URL="https://app.saifulegendconnect.com/api"

# --- SMEPlug Integration ---
SMEPLUG_API_KEY="your_smeplug_api_key"
SMEPLUG_BASE_URL="https://smeplug.ng/api/v1"


# ------------------------------------------------------------------------------
# 6. FIREBASE CLOUD MESSAGING (FCM) & PUSH NOTIFICATIONS
# ------------------------------------------------------------------------------
# Option A (Cloud / Vercel): Inline stringified JSON of the service account credentials
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"mkdata-sample","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@mkdata-sample.iam.gserviceaccount.com"}'

# Option B (Local Dev): Absolute or relative filesystem path to service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
