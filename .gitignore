# ==============================================================================
# MK DATA — Git Ignore Specification
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Caches
.next/
out/
build/
dist/

# Environment Variables & Local Overrides (Strictly Keep .env.example)
.env
.env*.local
.env.production
.env.staging
!.env.example

# Security Credentials, Private Keys & Keystores
*.pem
*.key
*.jks
*.keystore
key.properties
*firebase-adminsdk*.json

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# System Artifacts & OS Metadata
.DS_Store
Thumbs.db
desktop.ini

# TypeScript & Vercel
*.tsbuildinfo
next-env.d.ts
.vercel/
